{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "adr",
        "sop",
        "chore",
        "refactor",
        "test",
        "ci",
        "perf",
        "security",
        "content",
        "revert"
      ]
    ],
    "subject-case": [2, "always", "lower-case"],
    "subject-max-length": [2, "always", 100],
    "body-max-line-length": [0]
  }
}
